# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:3000"]

# Database (host value when running services directly)
DATABASE_URL=postgresql+psycopg://review:review@localhost:5432/review_platform
DATABASE_ECHO=false

# Frontend server-side connection to FastAPI
API_BASE_URL=http://localhost:8000

# Provider selection: local implementations require no paid credentials
AI_PROVIDER=mock
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/objects
NOTIFICATION_PROVIDER=mock

# Reserved for later integrations; do not add real values to this file
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENALEX_MAILTO=
GROBID_URL=http://localhost:8070
TEMPORAL_ADDRESS=localhost:7233


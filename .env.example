# Application
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_API_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:3000"]
APP_SECURITY_HEADERS_ENABLED=true
APP_METRICS_ENABLED=true
APP_RATE_LIMIT_ENABLED=true
APP_AUTH_RATE_LIMIT_REQUESTS=10
APP_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Database (host value when running services directly)
DATABASE_URL=postgresql+psycopg://review:review@localhost:5432/review_platform
DATABASE_ECHO=false
DATABASE_REQUIRE_MIGRATIONS=false
DATABASE_EXPECTED_REVISION=20260819_0035

# Frontend server-side connection to FastAPI
API_BASE_URL=http://localhost:8000

# Provider selection: local implementations require no paid credentials
AI_PROVIDER=mock
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/objects
NOTIFICATION_PROVIDER=mock

# Local-only identity bootstrap. Set the password in an untracked .env file.
AUTHENTICATION_PROVIDER=local
LOCAL_AUTH_SECRET=local-development-only-change-me
LOCAL_AUTH_TOKEN_TTL_SECONDS=3600
LOCAL_ADMIN_EMAIL=owner@example.test
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_DISPLAY_NAME=Local Owner
LOCAL_ORGANIZATION_NAME=Local Research Organization
LOCAL_ORGANIZATION_SLUG=local-research

# Reserved for later integrations; do not add real values to this file
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENALEX_MAILTO=
GROBID_URL=http://localhost:8070
TEMPORAL_ADDRESS=localhost:7233

# Compose-only local database defaults. Replace these together for local Docker use;
# production secrets must come from an external secret manager, not this file.
POSTGRES_DB=review_platform
POSTGRES_USER=review
POSTGRES_PASSWORD=review

# Worker polling and graceful shutdown
WORKER_POLL_INTERVAL_SECONDS=1.0
